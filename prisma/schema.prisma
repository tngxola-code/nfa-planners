generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url is now defined in prisma7.config.ts
}

model Opportunity {
  id            String   @id @default(cuid())
  reference     String
  title         String
  description   String?
  client        String
  location      String?
  province      String?
  category      String?
  closingDate   DateTime
  publishedDate DateTime?
  source        String
  sourceUrl     String?
  documentUrls  String[]
  estimatedValue String?
  contactEmail  String?
  contactPhone  String?
  fitScore      Int
  fitReason     String?
  hash          String   @unique
  ingestedAt    DateTime @default(now())
  notifiedAt    DateTime?
  status        String   @default("active")

  @@index([closingDate])
  @@index([fitScore])
  @@index([status])
}

model OpportunityHistory {
  id                String   @id @default(cuid())
  opportunityHash   String
  status            String   // active, cancelled, awarded, etc.
  statusChangedAt   DateTime @default(now())
  awardee           String?
  awardAmount       Float?
  awardCurrency     String?
  source            String   // "BULK" or "API"
  ingestedAt        DateTime @default(now())
  rawData           Json?    // full release JSON for auditing

  @@index([opportunityHash])
  @@index([status])
}

model MonthlyFile {
  id          String   @id @default(cuid())
  year        Int
  month       Int
  fileUrl     String   @unique
  processedAt DateTime @default(now())
  recordCount Int
}
